<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registros de Pagos</title>
    <link rel="stylesheet" href="/css/table.css">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
         :root {
        --primary:  #0066cc;
        --secondary:#00ccff;
        --accent:   #ff6600;
        --dark:     #1a1a2e;
        --light:    #f8f9fa;
    }
    </style>
</head>
<body class="bg-gray-100 font-['Roboto'] text-gray-800">
  <!-- Navbar -->
  <%- include('partials/navbar') %>

  <!-- Filtros -->
  <main class="pt-24 px-4 md:px-8 max-w-7xl mx-auto">
    <form id="filterForm" class="mb-8 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      <input id="searchInput" type="text"
      placeholder="🔍 <%= __('filtrosPagos.buscar') %>"
      class="px-4 py-2 border border-gray-300 rounded-lg w-full shadow-sm" />

      <select id="estadoSelect" class="px-4 py-2 border border-gray-300 rounded-lg w-full shadow-sm">
        <option value=""><%= __('filtrosPagos.todosEstados') %></option>
        <option value="aprobado"><%= __('filtrosPagos.aprobado') %></option>
        <option value="rechazado"><%= __('filtrosPagos.rechazado') %></option>
        <option value="pendiente"><%= __('filtrosPagos.pendiente') %></option>
    </select>

    <select id="servicioSelect" class="px-4 py-2 border border-gray-300 rounded-lg w-full shadow-sm">
        <option value=""><%= __('filtrosPagos.todosServicios') %></option>
        <option value="Suscripción Mensual"><%= __('filtrosPagos.suscripcionMensual') %></option>
        <option value="Suscripción Anual"><%= __('filtrosPagos.suscripcionAnual') %></option>
    </select>

    <input type="date" id="fechaInicio" class="px-4 py-2 border border-gray-300 rounded-lg w-full shadow-sm" />
    <input type="date" id="fechaFin" class="px-4 py-2 border border-gray-300 rounded-lg w-full shadow-sm" />
</form>

<!-- Tabla -->
<div class="bg-white shadow-md rounded-lg overflow-x-auto p-6">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold text-gray-700 flex items-center gap-2">
      <i class="fas fa-credit-card text-indigo-500"></i>
      <span><%= __('pagos.tituloRegistros') %></span>
  </h1>
  <span class="text-sm text-gray-500"><%= __('pagos.total') %>: <%= datePayments.length %></span>
</div>

<% if (datePayments.length > 0) { %>
<table class="min-w-full divide-y divide-gray-200 text-sm text-left">
  <thead class="bg-gray-100 text-gray-700">
    <tr>
      <th class="px-4 py-2"><%= __('pagos.tabla.titular') %></th>
      <th class="px-4 py-2"><%= __('pagos.tabla.correo') %></th>
      <th class="px-4 py-2"><%= __('pagos.tabla.descripcion') %></th>
      <th class="px-4 py-2"><%= __('pagos.tabla.tarjeta') %></th>
      <th class="px-4 py-2"><%= __('pagos.tabla.expiracion') %></th>
      <th class="px-4 py-2"><%= __('pagos.tabla.moneda') %></th>
      <th class="px-4 py-2"><%= __('pagos.tabla.monto') %></th>
      <th class="px-4 py-2"><%= __('pagos.tabla.referencia') %></th>
      <th class="px-4 py-2"><%= __('pagos.tabla.fecha') %></th>
  </tr>
</thead>
<tbody>
    <% datePayments.forEach(payment => { 
       const date = new Intl.DateTimeFormat(locale).format(new Date(payment.createdAt));
       const time = new Intl.DateTimeFormat(locale, {hour:'2-digit', minute:'2-digit'}).format(new Date(payment.createdAt));
       const number = new Intl.NumberFormat(locale, {style:'currency',currency: payment.currency}).format(payment.amount);
   %>
   <tr class="hover:bg-gray-50">
      <td class="px-6 py-4"><%= payment.nombreTitular %></td>
      <td class="px-6 py-4"><a href="mailto:<%= payment.correo %>"><%= payment.correo %></a></td>
      <td class="px-6 py-4">•••• •••• •••• <%= payment.cardNumber.slice(-4) %></td>
      <td class="px-6 py-4 text-gray-600"><%= payment.expMonth %>/<%= payment.expYear.toString().slice(-2) %></td>
      <td class="px-6 py-4"><%= number %></td>
      <td class="px-6 py-4 text-gray-600 line-clamp-2"><%= payment.descripcion %></td>
      <td class="px-6 py-4 text-gray-600 font-mono"><%= payment.reference %></td>
      <td class="px-6 py-4 text-sm text-gray-500"><div><%= date %></div><div class="text-xs"><%= time %></div></td>
      <td data-label="Fecha" class="contact-date">
        <%= new Date(payment.createdAt).toLocaleDateString() %>
        <br>
        <%= new Date(payment.createdAt).toLocaleTimeString() %>
    </td>
</tr>
<% }) %>
</tbody>
</table>
<% } else { %>
<p class="text-center text-gray-500 py-6"><%= __('pagos.noRegistros') %></p>
<% } %>
</div>
</main>

<script src="/js/filterPayment.js"></script>
</body>
</html>