<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro de Pago</title>
  <link rel="stylesheet" href="/css/payment.css">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <script src='/js/alertConfig.js'></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
      :root {
        --primary:  #0066cc;
        --secondary:#00ccff;
        --accent:   #ff6600;
        --dark:     #1a1a2e;
        --light:    #f8f9fa;
    }
</style>
</head>

<body class="bg-gray-100 font-['Roboto'] min-h-screen flex items-center justify-center px-4 py-10">
  <%-include('partials/navbar')%>
  <div class="mt-20 w-full max-w-lg bg-white shadow-xl rounded-xl p-8">
    
    <!-- Encabezado -->
    <header class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-gray-700 flex items-center justify-center gap-2">
        <%= __('paymentForm.title') %> <i class="fas fa-credit-card text-indigo-500"></i>
      </h1>
      <p class="text-gray-500 mt-2"><%= __('paymentForm.subtitle') %></p>
    </header>

    <!-- Formulario -->
    <form id="formularioPayment" class="space-y-6">
      
      <!-- Correo -->
      <div>
        <label for="correo" class="block text-sm font-medium mb-1"><%= __('paymentForm.email') %></label>
        <input id="correo" name="correo" type="email"
               placeholder="<%= __('paymentForm.emailPlaceholder') %>"
               class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
      </div>

      <!-- Titular -->
      <div>
        <label for="nombreTitular" class="block text-sm font-medium mb-1"><%= __('paymentForm.cardholder') %></label>
        <input id="nombreTitular" name="nombreTitular" type="text"
               placeholder="<%= __('paymentForm.cardholderPlaceholder') %>"
               class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
      </div>

      <!-- Número de tarjeta -->
      <div>
        <label for="cardNumber" class="block text-sm font-medium mb-1"><%= __('paymentForm.cardNumber') %></label>
        <select id="cardNumber" name="cardNumber"
                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
          <option value="4111111111111111">4111 1111 1111 1111</option>
          <option value="5555555555554444">5555 5555 5555 4444</option>
          <option value="378282246310005">3782 822463 10005</option>
          <option value="6011111111111117">6011 1111 1111 1117</option>
          <option value="3530111333300000">3530 111333 300000</option>
          <option value="30569309025904">3056 930902 5904</option>
        </select>
      </div>

      <!-- Detalles tarjeta (exp + cvv + descripción) -->
      <div class="grid sm:grid-cols-2 gap-4">
        <!-- Expiración -->
        <div>
          <label class="block text-sm font-medium mb-1"><%= __('paymentForm.expDate') %></label>
          <div class="flex gap-2">
            <select id="expMonth" name="expMonth"
                    class="w-1/2 border border-gray-300 rounded-lg px-2 py-2 focus:ring-indigo-500" required>
              <option value="" disabled selected><%= __('paymentForm.month') %></option>
              <% for (let i = 1; i <= 12; i++) { %>
                <option value="<%= i < 10 ? '0'+i : i %>"><%= i < 10 ? '0'+i : i %></option>
              <% } %>
            </select>
            <select id="expYear" name="expYear"
                    class="w-1/2 border border-gray-300 rounded-lg px-2 py-2 focus:ring-indigo-500" required>
              <option value="" disabled selected><%= __('paymentForm.year') %></option>
              <% const currentYear = new Date().getFullYear(); %>
              <% for (let i = 0; i < 10; i++) { %>
                <option value="<%= currentYear + i %>"><%= currentYear + i %></option>
              <% } %>
            </select>
          </div>
        </div>

        <!-- CVV -->
        <div>
          <label for="cvv" class="block text-sm font-medium mb-1"><%= __('paymentForm.securityCode') %></label>
          <input id="cvv" name="cvv" type="text"
                 placeholder="<%= __('paymentForm.cvvPlaceholder') %>"
                 class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-indigo-500"
                 pattern="[0-9]{3,4}" required>
        </div>

        <!-- Descripción -->
        <div class="sm:col-span-2">
          <label for="descripcion" class="block text-sm font-medium mb-1"><%= __('paymentForm.description') %></label>
          <input id="descripcion" name="descripcion" type="text"
                 placeholder="<%= __('paymentForm.descriptionPlaceholder') %>"
                 class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-indigo-500" required>
        </div>
      </div>

      <!-- Monto y moneda -->
      <div>
        <label class="block text-sm font-medium mb-1"><%= __('paymentForm.amount') %></label>
        <div class="flex gap-2">
          <select id="currency" name="currency"
                  class="w-1/3 border border-gray-300 rounded-lg px-2 py-2 focus:ring-indigo-500" required>
            <option value="USD"><%= __('paymentForm.currencyUSD') %></option>
            <option value="EUR"><%= __('paymentForm.currencyEUR') %></option>
            <option value="GBP"><%= __('paymentForm.currencyGBP') %></option>
            <option value="JPY"><%= __('paymentForm.currencyJPY') %></option>
          </select>
          <input id="amount" name="amount" type="number" step="0.01" min="0"
                 placeholder="0.00"
                 class="flex-1 border border-gray-300 rounded-lg px-4 py-2 focus:ring-indigo-500" required>
        </div>
      </div>

      <!-- Botón -->
      <button type="submit"
              class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-lg transition flex items-center justify-center gap-2">
        <i class="fas fa-lock"></i> <%= __('paymentForm.payButton') %>
      </button>
    </form>
  </div>
</body>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src='/js/fetch2.js'></script>
  <script src="/js/script.js"></script>
</body>
</html>