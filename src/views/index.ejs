<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:image" content="<%= imageUrl %>">
    <meta property="og:url" content="<%= pageUrl %>">    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Poppins:wght@600&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>DATA CONTABILIDAD</title>
    <link rel="stylesheet" href="/css/style.css">

    <script src="/js/alertConfig.js"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6PR0JZ8E3L"></script>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-S2CFX5MH3V"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-S2CFX5MH3V');
</script>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<style>
      :root {
        --primary:  #0066cc;
        --secondary:#00ccff;
        --accent:   #ff6600;
        --dark:     #1a1a2e;
        --light:    #f8f9fa;
    }
</style>
</head>
<body>
<%-include('partials/navbar')%>
<!-- HEADER HERO -->
<header class="pt-20 bg-[var(--primary)] text-[var(--light)]">
  <div class="max-w-6xl mx-auto px-4 py-24 flex flex-col md:flex-row items-center gap-10">
    <div class="flex-1 text-center md:text-left">
      <h1 class="text-4xl md:text-5xl font-bold mb-4"><%= __('home.hero.title') %></h1>
      <p class="mb-6 text-lg"><%= __('home.hero.subtitle') %></p>
      <a href="#Encuesta" class="inline-block bg-[var(--accent)] hover:bg-orange-600 text-white py-3 px-6 rounded-lg transition">
        <%= __('home.hero.cta') %>
    </a>
</div>
<img src="/img/user_17827179.png" alt="Hero img" class="w-60 md:w-80 rounded-lg shadow-lg">
</div>
</header>

<!-- USUARIOS SECTION -->
<section id="Usuarios" class="py-16 bg-[var(--light)]">
  <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-10 items-center">
    <!-- Card -->
    <article class="bg-white rounded-xl shadow p-6 flex flex-col items-center text-center">
      <img src="/img/user_17827179.png" class="w-32 h-32 rounded-full mb-4 object-cover" alt="">
      <h2 class="text-2xl font-semibold mb-2"><%= __('users.card.title') %></h2>
      <ul class="space-y-1 text-gray-700">
        <li><%= __('users.card.nombre') %></li>
        <li><%= __('users.card.apellido') %></li>
        <li><%= __('users.card.cedula') %></li>
        <li><%= __('users.card.experiencia') %></li>
    </ul>
    <a href="#Encuesta" class="mt-4 inline-block bg-[var(--secondary)] hover:bg-cyan-400 text-[var(--dark)] font-medium py-2 px-4 rounded">
        <%= __('global.explorar') %>
    </a>
</article>

<!-- Texto -->
<article class="text-gray-800 leading-relaxed">
  <img src="/img/construction_15941389.png" alt="" class="w-full mb-6 rounded-lg shadow">
  <p><b><%= __('users.text.bold') %></b> <%= __('users.text.body') %></p>
</article>
</div>
</section>

<!-- HERO IMAGE FULL WIDTH -->
<div class="w-full">
  <img src="/img/VINOTINTO.jpg" class="w-full object-cover max-h-[400px]" alt="">
</div>

<!-- BENEFICIOS / DESVENTAJAS (rejilla reutilizable) -->
<section class="py-16">
  <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-12">
    <!-- Ventajas -->
    <div>
      <h2 class="text-3xl font-bold mb-6"><%= __('beneficios.title') %></h2>
      <ul class="space-y-4 list-disc list-inside text-gray-700">
        <li><%= __('beneficios.item1') %></li>
        <li><%= __('beneficios.item2') %></li>
        <li><%= __('beneficios.item3') %></li>
    </ul>
</div>

<!-- Desventajas -->
<div>
  <h2 class="text-3xl font-bold mb-6"><%= __('desventajas.title') %></h2>
  <ul class="space-y-4 list-disc list-inside text-gray-700">
    <li><%= __('desventajas.item1') %></li>
    <li><%= __('desventajas.item2') %></li>
    <li><%= __('desventajas.item3') %></li>
</ul>
</div>
</div>
</section>

<!-- FORMULARIO -->
<section id="Encuesta" class="py-16 bg-[var(--light)]">
  <div class="max-w-lg mx-auto px-4">
    <h2 class="text-3xl font-semibold text-center mb-8"><%= __('form.title') %></h2>
    <form id="formulario" class="space-y-6 bg-white p-8 rounded-lg shadow">
      <div>
        <label for="nombre" class="block text-sm font-medium mb-1"><%= __('form.nombre') %></label>
        <input type="text" name="nombre" id="nombre" class="w-full border rounded px-3 py-2" required>
    </div>

    <div>
        <label for="email" class="block text-sm font-medium mb-1"><%= __('form.email') %></label>
        <input type="email" name="email" id="email" class="w-full border rounded px-3 py-2" required>
    </div>

    <div>
        <label for="comentario" class="block text-sm font-medium mb-1"><%= __('form.comentario') %></label>
        <textarea id="comentario" name="comentario" rows="4" class="w-full border rounded px-3 py-2" required></textarea>
    </div>

    <div class="g-recaptcha" data-sitekey="<%= sitioKey %>"></div>

    <button class="w-full bg-[var(--primary)] hover:bg-blue-700 text-white py-3 rounded-lg font-semibold">
        <%= __('form.enviar') %>
    </button>
</form>
</div>
</section>

<!-- FOOTER -->
<footer class="bg-[var(--dark)] text-[var(--light)] py-8">
  <div class="max-w-6xl mx-auto px-4 text-center">
    <p class="mb-6"><%= __('footer.mission') %></p>
    <ul class="flex justify-center gap-6 mb-6">
      <li><a href="#Usuarios" class="hover:text-[var(--secondary)]"><%= __('footer.usuarios') %></a></li>
      <li><a href="#Empresa"  class="hover:text-[var(--secondary)]"><%= __('footer.nosotros') %></a></li>
      <li><a href="/payment"  class="hover:text-[var(--secondary)]"><%= __('footer.suscribirse') %></a></li>
  </ul>
  <p class="text-sm">&copy; 2025 ContaApp – <%= __('footer.derechos') %></p>
</div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src='/js/animacion.js'></script>
<script src='/js/fetch.js'></script>
<script src="/js/desplegable.js"></script>
</body>

</html>
